# --- Public app URL (used to build SATIM return/fail URLs) ---
APP_URL=http://localhost:3000

# --- Redis (tasdid payment store) ---
REDIS_URL=redis://localhost:6379

# --- SATIM gateway (the @bakissation/satim client reads SATIM_*) ---
# Point this at the mock for local/CI, or at real SATIM (https://cib.satim.dz/payment/rest) in prod.
SATIM_API_URL=http://localhost:8888/payment/rest
# Credentials are ignored by the mock — set anything. Real SATIM issues these to the merchant.
SATIM_USERNAME=demo-merchant
SATIM_PASSWORD=demo-password
SATIM_TERMINAL_ID=E010900000

# --- Admin guard for /api/pay/reconcile and /api/pay/refund ---
PAY_ADMIN_TOKEN=dev-admin-token
